{
  "name": "Hanglet – Word Game",
  "short_name": "Hanglet",
  "description": "A calm word guessing game. Daily challenge, Classic, 40 levels and Time Attack.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f7f9",
  "theme_color": "#1d63d8",
  "categories": ["games", "education"],
  "icons": [
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Daily", "url": "./play.html?mode=daily", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Classic", "url": "./play.html?mode=classic", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
